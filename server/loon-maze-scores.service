# systemd service for the Loon Maze world high score server.
# Installed to /etc/systemd/system/ by scripts/deploy.sh.
[Unit]
Description=Loon Maze world high scores
After=network.target

[Service]
Type=simple
# A dedicated user with no login or home, so the service can't touch anything
# but its own scores file. (deploy.sh creates it.)
User=loon-scores
Group=loon-scores
WorkingDirectory=/opt/loon-maze-scores
ExecStart=/usr/bin/node /opt/loon-maze-scores/server/scores-server.js
# Only reachable from inside the container; nginx passes /api/ requests to it.
Environment=HOST=127.0.0.1
Environment=PORT=3010
Environment=DATA_DIR=/var/lib/loon-maze
Restart=always
RestartSec=5

# Sandboxing: if the server ever had a bug, it still couldn't gain privileges,
# write anywhere but its scores folder, or see the rest of the system. (Checked
# to work inside the Proxmox LXC container.)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/loon-maze
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
MemoryMax=256M

[Install]
WantedBy=multi-user.target
